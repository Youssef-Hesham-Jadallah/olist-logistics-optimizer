# Copy to .env and edit (loaded automatically; real environment variables take precedence). Never commit real secrets.
# APP_ENV=production   # refuse to start with weak/missing secrets or demo users
APP_ENV=development
JWT_SECRET=change-me-to-a-long-random-string
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-now
WEBHOOK_SECRET=change-me-too
# SEED_DEMO_USERS=true   # creates operator/operator123 and viewer/viewer123 -- demos only
CORS_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
OLIST_DATA_DIR=./olist_data
DB_PATH=./logistics.db
MAX_UPLOAD_MB=60
